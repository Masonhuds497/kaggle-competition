n      <td>6942</td>\n      <td>10.90</td>\n    </tr>\n    <tr>\n      <th>CatNose</th>\n      <td>6942</td>\n      <td>10.90</td>\n    </tr>\n    <tr>\n      <th>DogEye</th>\n      <td>11580</td>\n      <td>18.19</td>\n    </tr>\n    <tr>\n      <th>DogFace</th>\n      <td>5790</td>\n      <td>9.10</td>\n    </tr>\n    <tr>\n      <th>DogMouth</th>\n      <td>5790</td>\n      <td>9.10</td>\n    </tr>\n    <tr>\n      <th>DogNose</th>\n      <td>5790</td>\n      <td>9.10</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 880x385 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"8 classes | largest/smallest = 2.40\nVerdict: IMBALANCED (ratio >= 1.5) - consider class weights / macro-F1\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"### 1.3 Sample images from every class","metadata":{}},{"cell_type":"code","source":"def show_grid(df, per_class=6, size=96, title=\"\", fname=None):\n    classes = sorted(df[\"label\"].unique())\n    fig, axes = plt.subplots(len(classes), per_class, figsize=(per_class * 1.5, len(classes) * 1.5))\n    rng = np.random.RandomState(SEED)\n    for r, c in enumerate(classes):\n        sub = df[df[\"label\"] == c]\n        pick = sub.sample(min(per_class, len(sub)), random_state=rng)[\"path\"].tolist()\n        for k in range(per_class):\n            ax = axes[r, k]; ax.axis(\"off\")\n            if k < len(pick):\n                ax.imshow(Image.open(pick[k]).convert(\"RGB\").resize((size, size)))\n            if k == 0: ax.set_title(c, fontsize=9, loc=\"left\")\n    fig.suptitle(title); plt.tight_layout()\n    if fname: plt.savefig(FIG / fname)\n    plt.show()\nshow_grid(train_df, title=\"Random training samples per class\", fname=\"samples_per_class.png\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T07:50:26.226577Z","iopub.execute_input":"2026-10-24T07:50:26.226923Z","iopub.status.idle":"2026-10-24T07:50:28.232454Z","shell.execute_reply.started":"2026-10-24T07:50:26.226891Z","shell.execute_reply":"2026-10-24T07:50:28.231450Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 990x1320 with 48 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":7},{"cell_type":"markdown","source":"### 1.4 Data-quality audit (one pass over train and test)\nChecks: unreadable files, size and aspect-ratio variation, blur (variance of the Laplacian), exact duplicates (MD5), near duplicates (difference hash), label conflicts among duplicates, and train/test overlap. Results are cached so re-runs are fast.","metadata":{}},{"cell_type":"code","source":"def dhash(im, n=8):\n    g = np.asarray(im.convert(\"L\").resize((n + 1, n), Image.BILINEAR), dtype=np.int16)\n    bits = (g[:, 1:] > g[:, :-1]).flatten()\n    return format(int(\"\".join(\"1\" if b else \"0\" for b in bits), 2), \"016x\")\n\ndef lap_var(im):\n    g = np.asarray(im.convert(\"L\").resize((64, 64), Image.BILINEAR), dtype=np.float32)\n    lap = -4 * g[1:-1, 1:-1] + g[:-2, 1:-1] + g[2:, 1:-1] + g[1:-1, :-2] + g[1:-1, 2:]\n    return float(lap.var())\n\ndef scan_one(p):\n    try:\n        with open(p, \"rb\") as f: md5 = hashlib.md5(f.read()).hexdigest()\n        with Image.open(p) as im:\n            im.load(); im = im.convert(\"RGB\")\n            return dict(path=str(p), ok=True, w=im.width, h=im.height, md5=md5, dhash=dhash(im), blur=lap_var(im))\n    except Exception as e:\n        return dict(path=str(p), ok=False, err=str(e)[:80])\n\ndef scan(paths, name):\n    cache = OUT / f\"scan_{name}.csv\"\n    if cache.exists():\n        c = pd.read_csv(cache, dtype={\"dhash\": str})\n        if set(c[\"path\"]) == set(map(str, paths)): return c\n    res = pd.DataFrame([scan_one(p) for p in tqdm(paths, desc=f\"scan {name}\")])\n    res.to_csv(cache, index=False); return res\n\ntr_scan = scan(train_df[\"path\"].tolist(), \"train\")\nte_scan = scan(test_paths, \"test\")\nfor nm,