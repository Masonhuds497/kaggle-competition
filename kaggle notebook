    "### 2.2 Train / validation split (stratified, group-aware, fixed seed)\n",
    "`StratifiedGroupKFold` keeps class proportions the same in both parts and puts every set of byte-identical files (same MD5) on the same side of the split. That prevents optimistic validation scores caused by duplicate leakage."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "sgkf = StratifiedGroupKFold(n_splits=N_SPLITS, shuffle=True, random_state=SEED)\n",
    "tr_idx, va_idx = next(sgkf.split(train_df, train_df[\"y\"], groups=train_df[\"md5\"]))\n",
    "tr_df, va_df = train_df.iloc[tr_idx].reset_index(drop=True), train_df.iloc[va_idx].reset_index(drop=True)\n",
    "\n",
    "# leakage guards (hard failures)\n",
    "assert set(tr_df.path).isdisjoint(va_df.path), \"path leakage\"\n",
    "assert set(tr_df.md5).isdisjoint(va_df.md5), \"duplicate-content leakage\"\n",
    "assert set(va_df.md5).isdisjoint(te_scan.md5) and set(tr_df.md5).isdisjoint(te_scan.md5), \"train/test identical files\"\n",
    "print(f\"train {len(tr_df):,} | validation {len(va_df):,} ({100*len(va_df)/len(train_df):.1f} %)\")\n",
    "display(pd.DataFrame({\"train_%\": 100 * tr_df.label.value_counts(normalize=True), \"val_%\": 100 * va_df.label.value_counts(normalize=True)}).round(2).sort_index())\n",
    "tr_df.to_csv(OUT / \"split_train.csv\", index=False); va_df.to_csv(OUT / \"split_val.csv\", index=False)"
   ]
